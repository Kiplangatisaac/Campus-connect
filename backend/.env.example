# KyU Campus Connect - Environment Variables
# Copy this to .env and fill in your values

APP_NAME=KyU Campus Connect
APP_VERSION=1.0.0
DEBUG=false

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./campus.db
SYNC_DATABASE_URL=sqlite:///./campus.db

# PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/campus
# SYNC_DATABASE_URL=postgresql://user:pass@localhost:5432/campus

# JWT Secrets (generate random strings for production)
JWT_SECRET_KEY=your-secret-key-change-this
JWT_REFRESH_SECRET_KEY=your-refresh-secret-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Base URL (set to your domain or ngrok URL)
BASE_URL=http://localhost:8001

# University email domains
UNIVERSITY_DOMAIN=students.kyu.ac.ke
UNIVERSITY_DOMAINS=["students.kyu.ac.ke","staffs.kyu.ac.ke","kyu.ac.ke"]

# CORS (comma-separated origins)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:5173","http://localhost:8001"]

# Google OAuth (get from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/callback/google

# Microsoft OAuth (get from Azure Portal)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3001/auth/callback/microsoft

# Apple OAuth (get from Apple Developer)
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=http://localhost:3001/auth/callback/apple

# Social providers enabled
SOCIAL_PROVIDERS=["google","microsoft"]

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0
